double C2M_PWin(const double &f[], const int win)
{
   double z = C2M_intercept[win];
   for(int i=0;i<C2M_NFEAT;i++)
   {
      double s = (C2M_scale[win][i]>0.0 ? (f[i]-C2M_mean[win][i])/C2M_scale[win][i] : 0.0);
      z += C2M_coef[win][i]*s;
   }
   return 1.0/(1.0+MathExp(-z));
}

// ===== RISK LAYER (v1.00, tested T1/T2) =====
CTrade   trade;
string   GV_PREFIX;                              // персистентний стан (рестарт-safe)
double   g_initial_equity = 0.0;
double   g_day_start_equity = 0.0;
datetime g_cur_day = 0;
int      g_trades_today = 0;
int      g_consec_losses = 0;
datetime g_block_until = 0;                      // cooldown
bool     g_global_stop = false;
datetime g_last_hist_check = 0;

//+------------------------------------------------------------------+
string TradeIdStr(const int dir)
  {
   MqlDateTime dt; TimeToStruct(TimeCurrent(), dt);
   string dirs = (dir > 0 ? "BUY" : "SELL");
   return StringFormat("%s_%04d%02d%02d_%02d%02d%02d_%s",
                       InpBotTag, dt.year, dt.mon, dt.day,
                       dt.hour, dt.min, dt.sec, dirs);
  }

void Log(const string type_, const string msg)
  {
   Print(StringFormat("%s|%s|%s", TimeToString(TimeCurrent(), TIME_DATE|TIME_SECONDS), type_, msg));
  }

string JsonEsc(string v)
  {
   StringReplace(v,"\\","\\\\"); StringReplace(v,"\"","\\\"");
   return v;
  }

void LogRemote(const string json_body)
  {
   if(StringLen(InpLoggerURL)<10) return;
   char data[]; char result[]; string rhdr;
   StringToCharArray(json_body, data, 0, StringLen(json_body));
   ResetLastError();
   int rc=WebRequest("POST", InpLoggerURL, "Content-Type: application/json\r\n", 3000, data, result, rhdr);
   if(rc==-1)
     {
      int h=FileOpen("FXA_C2_LogFallback.csv", FILE_READ|FILE_WRITE|FILE_ANSI|FILE_COMMON);
      if(h!=INVALID_HANDLE)
        {
         FileSeek(h,0,SEEK_END);
         FileWriteString(h, TimeToString(TimeCurrent(),TIME_DATE|TIME_SECONDS)+";"+json_body+"\r\n");
         FileClose(h);
        }
      static datetime last_warn=0;
      if(TimeCurrent()-last_warn>3600)
        { last_warn=TimeCurrent(); Log("LOGGER_WARN","WebRequest err="+IntegerToString(GetLastError())+" -> fallback CSV"); }
     }
  }

void RemoteEvent(const string type_, const string tid, const string payload)
  {
   LogRemote(StringFormat("{\"type\":\"%s\",\"trade_id\":\"%s\",\"payload\":\"%s\"}",
             type_, tid, JsonEsc(payload)));
  }

//--- персистентність через GlobalVariables терміналу
void SaveState()
  {
   GlobalVariableSet(GV_PREFIX + "consec",  (double)g_consec_losses);
   GlobalVariableSet(GV_PREFIX + "blockun", (double)(long)g_block_until);
   GlobalVariableSet(GV_PREFIX + "day",     (double)(long)g_cur_day);
   GlobalVariableSet(GV_PREFIX + "ntoday",  (double)g_trades_today);
   GlobalVariableSet(GV_PREFIX + "dayeq",   g_day_start_equity);
   GlobalVariableSet(GV_PREFIX + "initeq",  g_initial_equity);
   GlobalVariableSet(GV_PREFIX + "gstop",   g_global_stop ? 1.0 : 0.0);
   GlobalVariableSet(GV_PREFIX + "lastdeal",(double)(long)g_last_close_deal);
  }

void LoadState()
  {
   if(GlobalVariableCheck(GV_PREFIX + "consec"))
     {
      g_consec_losses    = (int)GlobalVariableGet(GV_PREFIX + "consec");
      g_block_until      = (datetime)(long)GlobalVariableGet(GV_PREFIX + "blockun");
      g_cur_day          = (datetime)(long)GlobalVariableGet(GV_PREFIX + "day");
      g_trades_today     = (int)GlobalVariableGet(GV_PREFIX + "ntoday");
      g_day_start_equity = GlobalVariableGet(GV_PREFIX + "dayeq");
      if(GlobalVariableCheck(GV_PREFIX + "lastdeal")) g_last_close_deal = (ulong)(long)GlobalVariableGet(GV_PREFIX + "lastdeal");
      g_initial_equity   = GlobalVariableGet(GV_PREFIX + "initeq");
      g_global_stop      = (GlobalVariableGet(GV_PREFIX + "gstop") > 0.5);
      Log("STATE", "відновлено після рестарту");
     }
  }

datetime DayStart(const datetime t)
  {
   return (datetime)((long)t - ((long)t % 86400));
  }

void RollDayIfNeeded()
  {
   datetime d = DayStart(TimeCurrent());
   if(d != g_cur_day)
     {
      g_cur_day = d;
      g_trades_today = 0;
      g_day_start_equity = AccountInfoDouble(ACCOUNT_EQUITY);
      Log("DAY_ROLL", StringFormat("новий день, day_eq=%.2f", g_day_start_equity));
      SaveState();
     }
  }

bool DailyStopHit()
  {
   if(g_day_start_equity <= 0.0) return false;
   double eq = AccountInfoDouble(ACCOUNT_EQUITY);
   double dd = (g_day_start_equity - eq) / g_day_start_equity * 100.0;
   return (dd >= InpDailyLossPct);      // блок ДО нового дня; RollDay відновлює — БЕЗ вічного стопу
  }

bool GlobalStopHit()
  {
   if(g_global_stop) return true;
   double eq = AccountInfoDouble(ACCOUNT_EQUITY);
   double dd = (g_initial_equity - eq) / g_initial_equity * 100.0;
   if(dd >= InpMaxLossPct)
     {
      g_global_stop = true;
      SaveState();
      Log("GLOBAL_STOP", StringFormat("dd=%.2f%% >= %.2f%% — повна зупинка, ревізія вручну", dd, InpMaxLossPct));
     }
   return g_global_stop;
  }

bool SpreadOK()
  {
   if(InpMaxSpreadPoints <= 0) return true;   // parity-режим: guard вимкнено
   long spr = SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
   return (spr <= InpMaxSpreadPoints);
  }

bool RiskAllowsEntry(string &why)
  {
   if(GlobalStopHit())                       { why = "GLOBAL_STOP";  return false; }
   if(DailyStopHit())                        { why = "DAILY_STOP";   return false; }
   if(g_trades_today >= InpMaxTradesPerDay)  { why = "DAY_CAP";      return false; }
   if(TimeCurrent() < g_block_until)         { why = "COOLDOWN";     return false; }
   if(!SpreadOK())                           { why = "SPREAD";       return false; }
   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)) { why = "NO_AUTOTRADING"; return false; }
   why = "";
   return true;
  }

//--- лот з ризику та SL-дистанції; нормалізація min/max/step
double CalcLot(const double sl_dist_price)
  {
   if(sl_dist_price <= 0.0) return 0.0;
   double tick_val  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double tick_size = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   if(tick_val <= 0.0 || tick_size <= 0.0) return 0.0;
   double risk_money = AccountInfoDouble(ACCOUNT_EQUITY) * InpRiskPct / 100.0;
   double loss_per_lot = sl_dist_price / tick_size * tick_val;
   if(loss_per_lot <= 0.0) return 0.0;
   double lot = risk_money / loss_per_lot;

   double vmin  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double vmax  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double vstep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   if(vstep <= 0.0) return 0.0;
   lot = MathFloor(lot / vstep) * vstep;
   if(lot < vmin) return 0.0;               // ризик менший за мін-лот -> НЕ торгуємо (не роздуваємо ризик)
   lot = MathMin(lot, MathMin(vmax, InpMaxLots));

   // маржа: ПРАВИЛО skill — ACCOUNT_MARGIN_FREE
   double margin_req = 0.0;
   if(!OrderCalcMargin(ORDER_TYPE_BUY, _Symbol, lot,
                       SymbolInfoDouble(_Symbol, SYMBOL_ASK), margin_req))
      return 0.0;
   if(margin_req > AccountInfoDouble(ACCOUNT_MARGIN_FREE) * 0.8)
     {
      Log("RISK", "маржі бракує, вхід скасовано");
      return 0.0;
     }
   return lot;
  }

//--- STOPLEVEL/FREEZELEVEL clamp
bool ClampStops(const int dir, const double entry, double &sl, double &tp)
  {
   double pt = _Point;
   long stoplvl_pts   = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL);
   long freezelvl_pts = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_FREEZE_LEVEL);
   double mind = (double)MathMax(stoplvl_pts, freezelvl_pts) * pt;
   if(mind <= 0.0) return true;
   if(dir > 0)
     {
      if(entry - sl < mind) sl = entry - mind;
      if(tp - entry < mind) tp = entry + mind;
     }
   else
     {
      if(sl - entry < mind) sl = entry + mind;
      if(entry - tp < mind) tp = entry - mind;
     }
   return (sl > 0.0 && tp > 0.0);
  }

//+------------------------------------------------------------------+
//| Виконання                                                        |
//+------------------------------------------------------------------+
bool OpenTrade(const int dir, double sl_dist_price)
  {
   string why = "";
   if(!RiskAllowsEntry(why))
     {
      Log("SKIP", "risk-шар: " + why);
      return false;
     }
   if(sl_dist_price < InpMinStopPoints*_Point)
     {
      Log("SKIP", StringFormat("MICRO_SL sd=%.5f < %dpt", sl_dist_price, InpMinStopPoints));
      return false;
     }
   double lot = CalcLot(sl_dist_price);
   if(lot <= 0.0)
     {
      Log("SKIP", "lot=0 (ризик/маржа/мін-лот)");
      return false;
     }
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double entry = (dir > 0 ? ask : bid);
   double sl = (dir > 0 ? entry - sl_dist_price : entry + sl_dist_price);
   double tp = (dir > 0 ? entry + sl_dist_price : entry - sl_dist_price);   // симетрія (канон: TP=1R звітний)
   if(!ClampStops(dir, entry, sl, tp))
     {
      Log("SKIP", "clamp стопів провалився");
      return false;
     }
   sl = NormalizeDouble(sl, _Digits);
   tp = NormalizeDouble(tp, _Digits);

   string tid = TradeIdStr(dir);
   bool ok = (dir > 0)
             ? trade.Buy(lot, _Symbol, 0.0, sl, tp, tid)
             : trade.Sell(lot, _Symbol, 0.0, sl, tp, tid);
   uint rc = trade.ResultRetcode();
   if(!ok || (rc != TRADE_RETCODE_DONE && rc != TRADE_RETCODE_PLACED))
     {
      if(rc == 10027)   // AutoTrading вимкнено клієнтом: БЕЗ retry-циклу (правило skill)
         Log("EXEC_FAIL", "ret=10027 AutoTrading off — угоду пропущено, retry заборонений");
      else
         Log("EXEC_FAIL", StringFormat("ret=%u %s", rc, trade.ResultRetcodeDescription()));
      return false;
     }
   g_trades_today++;
   SaveState();
   double fill = trade.ResultPrice();
   if(fill<=0.0) fill = (dir>0 ? SymbolInfoDouble(_Symbol,SYMBOL_ASK) : SymbolInfoDouble(_Symbol,SYMBOL_BID));
   double slip_pts = (fill>0 ? (dir>0 ? (fill-entry) : (entry-fill))/_Point : 0.0);
   Log("OPEN", StringFormat("%s lot=%.2f entry~%.5f fill=%.5f slip=%.1fpt sl=%.5f tp=%.5f",
       tid, lot, entry, fill, slip_pts, sl, tp));
   LogRemote(StringFormat("{\"type\":\"OPEN\",\"trade_id\":\"%s\",\"side\":%d,\"lot\":%.2f,"
             "\"planned\":%.5f,\"fill\":%.5f,\"slip\":%.1f,\"sd\":%.5f,\"p\":%.4f,\"thr\":%.4f}",
             tid, dir, lot, entry, fill, slip_pts, sl_dist_price, g_last_sig_p, g_thr));
   return true;
  }

//--- timeout-close 120хв відкритих позицій цього magic
void ManageTimeouts()
  {
   int total = PositionsTotal();
   for(int i = total - 1; i >= 0; i--)
     {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol)  continue;
      datetime opent = (datetime)PositionGetInteger(POSITION_TIME);
      if(TimeCurrent() - opent >= (long)InpTimeoutMinutes * 60)
        {
         if(!trade.PositionClose(ticket))
            Log("EXEC_FAIL", StringFormat("timeout-close ticket=%I64u ret=%u", ticket, trade.ResultRetcode()));
         else
            Log("CLOSE", StringFormat("TIMEOUT ticket=%I64u", ticket));
        }
     }
  }

//--- cooldown-стан з історії закритих угод (deal-based, рестарт-safe)
void UpdateCooldownFromHistory()
  {
   datetime now = TimeCurrent();
   if(now - g_last_hist_check < 5) return;      // не частіше 1 раз/5с
   datetime from = (g_last_hist_check == 0 ? now - 3 * 86400 : g_last_hist_check - 60);
   g_last_hist_check = now;
   if(!HistorySelect(from, now + 60)) return;
   int deals = HistoryDealsTotal();
   for(int i = 0; i < deals; i++)
     {
      ulong dt_ = HistoryDealGetTicket(i);
      if(dt_ == 0) continue;
      if(HistoryDealGetInteger(dt_, DEAL_MAGIC) != InpMagic) continue;
      if(HistoryDealGetInteger(dt_, DEAL_ENTRY) != DEAL_ENTRY_OUT) continue;
      double pl = HistoryDealGetDouble(dt_, DEAL_PROFIT)
                + HistoryDealGetDouble(dt_, DEAL_SWAP)
                + HistoryDealGetDouble(dt_, DEAL_COMMISSION);
      if(dt_<=g_last_close_deal) continue;   // CLOSE вже залоговано (анти-шторм)
      g_last_close_deal=dt_;
      double dvol=HistoryDealGetDouble(dt_,DEAL_VOLUME);
      double dprice=HistoryDealGetDouble(dt_,DEAL_PRICE);
      string dcomm=HistoryDealGetString(dt_,DEAL_COMMENT);
      long   pid=HistoryDealGetInteger(dt_,DEAL_POSITION_ID);
      LogRemote(StringFormat("{\"type\":\"CLOSE\",\"trade_id\":\"pos_%I64d\",\"reason\":\"%s\","
                "\"exit\":%.5f,\"profit\":%.2f}", pid, JsonEsc(dcomm), dprice, pl));
      if(pl < 0.0)
        {
         g_consec_losses++;
         if(g_consec_losses >= InpCooldownLosses)
           {
            g_block_until = (datetime)((long)HistoryDealGetInteger(dt_, DEAL_TIME) + (long)InpCooldownHours * 3600);
            Log("COOLDOWN", StringFormat("%d лосів поспіль -> пауза до %s",
                g_consec_losses, TimeToString(g_block_until, TIME_DATE|TIME_SECONDS)));
           }
        }
      else if(pl > 0.0)
         g_consec_losses = 0;
     }
   SaveState();
  }


// ===== ENGINE v003 (patched: silent mode + live hook) =====
//+------------------------------------------------------------------+
//| FXArena_LevelBattleEngine_v003_EVENT_STREAM.mq5                               |
//| Compact causal battle-round research exporter for MT5|
//| Research script only. It never sends trading orders.             |
//+------------------------------------------------------------------+
// (engine v003 properties removed in embed)

//----------------------------- Inputs -------------------------------
input string          InpSymbol                      = "";           // Empty = chart symbol
input ENUM_TIMEFRAMES InpBaseTimeframe               = PERIOD_M5;    // Episode/replay timeframe
input datetime        InpParityFrom                  = D'2023.04.01 00:00'; // parity export from
input datetime        InpParityTo                    = 0;                    // 0 = now

// Broadly visible levels
input bool            InpUsePreviousDayLevels        = true;
input bool            InpUsePreviousWeekLevels       = true;
input bool            InpUsePreviousMonthLevels      = true;
input bool            InpUseH1Swings                 = true;
input bool            InpUseH4Swings                 = true;
input int             InpSwingLeftBars               = 3;
input int             InpSwingRightBars              = 3;
input int             InpMaxSwingAgeDays             = 120;
input int             InpMaxCalendarLevelAgeDays     = 40;

// Episode segmentation
input int             InpATRPeriod                   = 14;
input double          InpTouchZoneATR                = 0.08;         // Zone half-width
input double          InpMinTouchZonePips            = 0.80;
input double          InpLeaveZoneATR                = 0.50;         // Required departure to finish episode
input int             InpLeaveConfirmBars            = 2;            // Consecutive closes away from zone
input int             InpMinBarsBetweenEpisodes      = 3;
input int             InpMaxEpisodeBars              = 48;
input int             InpMaxEpisodesPerLevel         = 0;            // 0 = unlimited; positive value = explicit censoring cap

// Structural-touch research (no fixed touch-count hypothesis)
input double          InpStructuralLeaveATR          = 1.00;         // Required departure before a new structural touch
input int             InpStructuralMinBars           = 12;           // Minimum bars between structural touches
input int             InpStructuralSwingLeftBars     = 2;
input int             InpStructuralSwingRightBars    = 2;
input double          InpReactionValidFloorATR       = 0.05;         // Avoid unstable reaction ratios

// State transitions
input int             InpAcceptanceBars              = 3;            // Consecutive closes beyond level
input int             InpFailureConfirmBars          = 1;            // Closes back through level after acceptance
input double          InpMeaningfulPenetrationATR    = 0.03;

// Battle-round context
input int             InpApproachBars                = 12;
input int             InpCompressionFastBars         = 6;
input int             InpCompressionSlowBars         = 24;
input int             InpTrendFastBars               = 12;
input int             InpTrendSlowBars               = 48;
input int             InpOutcomeBars                 = 48;
input int             InpBattleFastBars              = 6;            // Fast pressure window
input int             InpBattleSlowBars              = 18;           // Slow pressure window
input double          InpCloseNearLevelATR            = 0.20;         // Occupancy band around level

// Output
input bool            InpUseCommonFolder             = true;
input string          InpOutputPrefix                = "FXArena";
input bool            InpFlushFrequently             = true;

#define SIDE_RESISTANCE  1
#define SIDE_SUPPORT    -1

struct LevelData
{
   long             id;
   string           type;
   ENUM_TIMEFRAMES  source_tf;
   int              side;
   double           price;
   datetime         source_time;
   datetime         available_time;
   datetime         expiry_time;
   int              source_index;

   int              episodes;
   int              sweeps;
   int              rejections;
   int              acceptances;
   int              failed_acceptances;
   int              clean_breakouts;

   double           last_reaction_mfe_atr;
   double           last_reaction_mae_atr;
   int              last_episode_end_index;

   int              structural_touches;
   int              micro_in_current_structural;
   int              last_structural_touch_index;
   int              last_structural_end_index;
   double           last_structural_reaction_atr;
   double           prev2_structural_reaction_atr;
   double           last_structural_penetration_atr;
   double           prev2_structural_penetration_atr;
   double           reaction_sum_y;
   double           reaction_sum_xy;
   double           penetration_sum_y;
   double           penetration_sum_xy;
   double           structural_sum_x;
   double           structural_sum_x2;
};

string g_symbol;
double g_point=0.0;
double g_pip=0.0;
int    g_digits=0;
long   g_next_level_id=0;
long   g_next_event_id=0;

//+------------------------------------------------------------------+
string SideText(const int side)
{
   return (side==SIDE_RESISTANCE ? "RESISTANCE" : "SUPPORT");
}

//+------------------------------------------------------------------+
string TfText(const ENUM_TIMEFRAMES tf)
{
   if(tf==PERIOD_MN1) return "MN1";
   if(tf==PERIOD_W1)  return "W1";
   if(tf==PERIOD_D1)  return "D1";
   if(tf==PERIOD_H4)  return "H4";
   if(tf==PERIOD_H1)  return "H1";
   if(tf==PERIOD_M30) return "M30";
   if(tf==PERIOD_M15) return "M15";
   if(tf==PERIOD_M5)  return "M5";
   return EnumToString(tf);
}

//+------------------------------------------------------------------+
double SafeDiv(const double a,const double b,const double fallback=0.0)
{
   if(MathAbs(b)<1e-12) return fallback;
   return a/b;
}

//+------------------------------------------------------------------+
double TrueRange(const MqlRates &rates[],const int i)
{
   double tr=rates[i].high-rates[i].low;
   if(i<=0) return tr;
   tr=MathMax(tr,MathAbs(rates[i].high-rates[i-1].close));
   tr=MathMax(tr,MathAbs(rates[i].low-rates[i-1].close));
   return tr;
}

//+------------------------------------------------------------------+
double ATR(const MqlRates &rates[],const int i,const int period)
{
   if(period<=0 || i<period-1) return 0.0;
   double sum=0.0;
   for(int k=i-period+1;k<=i;k++) sum+=TrueRange(rates,k);
   return sum/period;
}

//+------------------------------------------------------------------+
double MeanRange(const MqlRates &rates[],const int from,const int to)
{
   if(to<from) return 0.0;
   double sum=0.0;
   int n=0;
   for(int i=from;i<=to;i++)
   {
      sum+=rates[i].high-rates[i].low;
      n++;
   }
   return (n>0 ? sum/n : 0.0);
}

//+------------------------------------------------------------------+
double MeanTickVolume(const MqlRates &rates[],const int from,const int to)
{
   if(to<from) return 0.0;
   double sum=0.0;
   int n=0;
   for(int i=from;i<=to;i++)
   {
      sum+=(double)rates[i].tick_volume;
      n++;
   }
   return (n>0 ? sum/n : 0.0);
}

//+------------------------------------------------------------------+
double DirectionalEfficiency(const MqlRates &rates[],const int from,const int to)
{
   if(to<=from) return 0.0;
   double net=MathAbs(rates[to].close-rates[from].close);
   double path=0.0;
   for(int i=from+1;i<=to;i++) path+=MathAbs(rates[i].close-rates[i-1].close);
   return SafeDiv(net,path,0.0);
}

//+------------------------------------------------------------------+
int CountAlignedBars(const MqlRates &rates[],const int from,const int to,const int expected_dir)
{
   int n=0;
   for(int i=from;i<=to;i++)
   {
      int dir=(rates[i].close>rates[i].open ? 1 : (rates[i].close<rates[i].open ? -1 : 0));
      if(dir==expected_dir) n++;
   }
   return n;
}

//+------------------------------------------------------------------+
double MeanBody(const MqlRates &rates[],const int from,const int to)
{
   if(to<from) return 0.0;
   double sum=0.0; int n=0;
   for(int i=from;i<=to;i++){sum+=MathAbs(rates[i].close-rates[i].open);n++;}
   return (n>0 ? sum/n : 0.0);
}

//+------------------------------------------------------------------+
double PathDistance(const MqlRates &rates[],const int from,const int to)
{
   if(to<=from) return 0.0;
   double path=0.0;
   for(int i=from+1;i<=to;i++) path+=MathAbs(rates[i].close-rates[i-1].close);
   return path;
}

//+------------------------------------------------------------------+
double SignedDirectionMove(const double from_price,const double to_price,const int direction)
{
   return direction*(to_price-from_price);
}

//+------------------------------------------------------------------+
double CloseLocationValue(const MqlRates &bar)
{
   double range=bar.high-bar.low;
   if(range<=0.0) return 0.5;
   return (bar.close-bar.low)/range;
}

//+------------------------------------------------------------------+
bool IsPivotHigh(const MqlRates &r[],const int i,const int left,const int right)
{
   if(i-left<0 || i+right>=ArraySize(r)) return false;
   double p=r[i].high;
   for(int k=1;k<=left;k++)  if(r[i-k].high>=p) return false;
   for(int k=1;k<=right;k++) if(r[i+k].high>p)  return false;
   return true;
}

//+------------------------------------------------------------------+
bool IsPivotLow(const MqlRates &r[],const int i,const int left,const int right)
{
   if(i-left<0 || i+right>=ArraySize(r)) return false;
   double p=r[i].low;
   for(int k=1;k<=left;k++)  if(r[i-k].low<=p) return false;
   for(int k=1;k<=right;k++) if(r[i+k].low<p)  return false;
   return true;
}

//+------------------------------------------------------------------+
void AddLevel(LevelData &levels[],const string type,const ENUM_TIMEFRAMES tf,const int side,
              const double price,const datetime source_time,const datetime available_time,
              const datetime expiry_time,const int source_index)
{
   int n=ArraySize(levels);
   ArrayResize(levels,n+1);
   levels[n].id=++g_next_level_id;
   levels[n].type=type;
   levels[n].source_tf=tf;
   levels[n].side=side;
   levels[n].price=NormalizeDouble(price,g_digits);
   levels[n].source_time=source_time;
   levels[n].available_time=available_time;
   levels[n].expiry_time=expiry_time;
   levels[n].source_index=source_index;
   levels[n].episodes=0;
   levels[n].sweeps=0;
   levels[n].rejections=0;
   levels[n].acceptances=0;
   levels[n].failed_acceptances=0;
   levels[n].clean_breakouts=0;
   levels[n].last_reaction_mfe_atr=EMPTY_VALUE;
   levels[n].last_reaction_mae_atr=EMPTY_VALUE;
   levels[n].last_episode_end_index=-1000000;
   levels[n].structural_touches=0;
   levels[n].micro_in_current_structural=0;
   levels[n].last_structural_touch_index=-1000000;
   levels[n].last_structural_end_index=-1000000;
   levels[n].last_structural_reaction_atr=EMPTY_VALUE;
   levels[n].prev2_structural_reaction_atr=EMPTY_VALUE;
   levels[n].last_structural_penetration_atr=EMPTY_VALUE;
   levels[n].prev2_structural_penetration_atr=EMPTY_VALUE;
   levels[n].reaction_sum_y=0.0;
   levels[n].reaction_sum_xy=0.0;
   levels[n].penetration_sum_y=0.0;
   levels[n].penetration_sum_xy=0.0;
   levels[n].structural_sum_x=0.0;
   levels[n].structural_sum_x2=0.0;
}

//+------------------------------------------------------------------+
int CopyHistory(const ENUM_TIMEFRAMES tf,const datetime from,const datetime to,MqlRates &rates[])
{
   ResetLastError();
   int copied=CopyRates(g_symbol,tf,from,to,rates);
   if(copied<=0)
   {
      PrintFormat("LEVEL_BATTLE_ERROR | CopyRates failed | symbol=%s tf=%s err=%d",
                  g_symbol,TfText(tf),GetLastError());
      return 0;
   }
   ArraySetAsSeries(rates,false);
   return copied;
}

//+------------------------------------------------------------------+
void BuildCalendarLevels(LevelData &levels[],const ENUM_TIMEFRAMES tf,const string high_type,
                         const string low_type,const int max_age_days)
{
   MqlRates r[];
   datetime warmup=g_run_from-(datetime)(90*86400);
   int n=CopyHistory(tf,warmup,g_run_to,r);
   if(n<2) return;

   for(int i=0;i<n-1;i++)
   {
      datetime available=r[i+1].time;
      if(available<g_run_from || available>=g_run_to) continue;
      datetime expiry=available+(datetime)(max_age_days*86400);
      if(i+2<n && r[i+2].time<expiry) expiry=r[i+2].time;
      AddLevel(levels,high_type,tf,SIDE_RESISTANCE,r[i].high,r[i].time,available,expiry,i);
      AddLevel(levels,low_type,tf,SIDE_SUPPORT,r[i].low,r[i].time,available,expiry,i);
   }
}

//+------------------------------------------------------------------+
void BuildSwingLevels(LevelData &levels[],const ENUM_TIMEFRAMES tf,const string high_type,
                      const string low_type)
{
   MqlRates r[];
   datetime warmup=g_run_from-(datetime)(InpMaxSwingAgeDays*86400);
   int n=CopyHistory(tf,warmup,g_run_to,r);
   if(n<InpSwingLeftBars+InpSwingRightBars+2) return;

   for(int i=InpSwingLeftBars;i<n-InpSwingRightBars;i++)
   {
      int confirm_index=i+InpSwingRightBars+1;
      if(confirm_index>=n) break;
      datetime available=r[confirm_index].time;
      if(available<g_run_from || available>=g_run_to) continue;
      datetime expiry=available+(datetime)(InpMaxSwingAgeDays*86400);
      if(IsPivotHigh(r,i,InpSwingLeftBars,InpSwingRightBars))
         AddLevel(levels,high_type,tf,SIDE_RESISTANCE,r[i].high,r[i].time,available,expiry,i);
      if(IsPivotLow(r,i,InpSwingLeftBars,InpSwingRightBars))
         AddLevel(levels,low_type,tf,SIDE_SUPPORT,r[i].low,r[i].time,available,expiry,i);
   }
}

//+------------------------------------------------------------------+
int FindFirstBaseIndexAtOrAfter(const MqlRates &base[],const datetime t)
{
   int lo=0,hi=ArraySize(base)-1,ans=ArraySize(base);
   while(lo<=hi)
   {
      int mid=(lo+hi)/2;
      if(base[mid].time>=t){ans=mid;hi=mid-1;}
      else lo=mid+1;
   }
   return ans;
}

//+------------------------------------------------------------------+
bool IsBeyond(const double close_price,const LevelData &level)
{
   return (level.side==SIDE_RESISTANCE ? close_price>level.price : close_price<level.price);
}

//+------------------------------------------------------------------+
bool IsRejectionSide(const double close_price,const double zone,const LevelData &level)
{
   return (level.side==SIDE_RESISTANCE ? close_price<level.price-zone : close_price>level.price+zone);
}

//+------------------------------------------------------------------+
bool IsBreakoutSide(const double close_price,const double zone,const LevelData &level)
{
   return (level.side==SIDE_RESISTANCE ? close_price>level.price+zone : close_price<level.price-zone);
}

//+------------------------------------------------------------------+
double SignedMoveFromLevel(const double price,const LevelData &level)
{
   double rejection_sign=(level.side==SIDE_RESISTANCE ? -1.0 : 1.0);
   return rejection_sign*(price-level.price);
}

//+------------------------------------------------------------------+
int FindDayOpenIndex(const MqlRates &base[],const int i)
{
   MqlDateTime now,cur;
   TimeToStruct(base[i].time,now);
   for(int k=i;k>=0;k--)
   {
      TimeToStruct(base[k].time,cur);
      if(cur.year!=now.year || cur.mon!=now.mon || cur.day!=now.day) return k+1;
   }
   return 0;
}



//+------------------------------------------------------------------+
bool StructuralResetConfirmed(const MqlRates &base[],const int from_i,const int touch_i,
                              const LevelData &level,const double atr_touch,
                              double &max_departure_atr,bool &swing_confirmed)
{
   max_departure_atr=0.0;
   swing_confirmed=false;
   if(from_i<0 || touch_i-from_i<InpStructuralMinBars || atr_touch<=0.0) return false;

   int scan_from=MathMax(0,from_i+1);
   int scan_to=touch_i-1;
   for(int i=scan_from;i<=scan_to;i++)
   {
      double departure=(level.side==SIDE_RESISTANCE ? level.price-base[i].close : base[i].close-level.price);
      max_departure_atr=MathMax(max_departure_atr,departure/atr_touch);

      if(level.side==SIDE_RESISTANCE)
      {
         if(IsPivotLow(base,i,InpStructuralSwingLeftBars,InpStructuralSwingRightBars) &&
            i+InpStructuralSwingRightBars<touch_i) swing_confirmed=true;
      }
      else
      {
         if(IsPivotHigh(base,i,InpStructuralSwingLeftBars,InpStructuralSwingRightBars) &&
            i+InpStructuralSwingRightBars<touch_i) swing_confirmed=true;
      }
   }
   return (max_departure_atr>=InpStructuralLeaveATR && swing_confirmed);
}

//+------------------------------------------------------------------+
double HistorySlope(const int n,const double sum_x,const double sum_x2,
                    const double sum_y,const double sum_xy)
{
   if(n<2) return EMPTY_VALUE;
   double den=n*sum_x2-sum_x*sum_x;
   if(MathAbs(den)<1e-12) return EMPTY_VALUE;
   return (n*sum_xy-sum_x*sum_y)/den;
}

//+------------------------------------------------------------------+
string CsvEscape(string value)
{
   StringReplace(value,"\"","\"\"");
   if(StringFind(value,";")>=0 || StringFind(value,"\"")>=0 || StringFind(value,"\n")>=0 || StringFind(value,"\r")>=0)
      value="\""+value+"\"";
   return value;
}

//+------------------------------------------------------------------+
void CsvAddText(string &line,const string value)
{
   if(StringLen(line)>0) line+=";";
   line+=CsvEscape(value);
}

//+------------------------------------------------------------------+
void CsvAddInt(string &line,const long value)
{
   CsvAddText(line,(string)value);
}

//+------------------------------------------------------------------+
void CsvAddDouble(string &line,const double value,const int digits=4)
{
   if(value==EMPTY_VALUE || !MathIsValidNumber(value) || MathAbs(value)>1.0e100)
   {
      CsvAddText(line,"");
      return;
   }
   CsvAddText(line,DoubleToString(value,digits));
}

//+------------------------------------------------------------------+
void CsvAddPrice(string &line,const double value)
{
   CsvAddDouble(line,value,g_digits);
}

//+------------------------------------------------------------------+
int StateCode(const string state)
{
   if(state=="NO_DECISION")            return 0;
   if(state=="REJECTION")              return 1;
   if(state=="SWEEP_REJECTION")        return 2;
   if(state=="BREAKOUT_NO_ACCEPTANCE") return 3;
   if(state=="CLEAN_BREAKOUT")         return 4;
   if(state=="FAILED_ACCEPTANCE")      return 5;
   return -1;
}

//+------------------------------------------------------------------+
void WriteLevelsHeader(const int h)
{
   if(h==INVALID_HANDLE) return;
   string line="level_id;level_type;source_tf;side;price;source_time_unix;"
               "available_time_unix;expiry_time_unix;source_index;total_micro_episodes;"
               "total_structural_touches;total_sweeps;total_rejections;total_acceptances;"
               "total_failed_acceptances;total_clean_breakouts";
   FileWriteString(h,line+"\r\n");
}

//+------------------------------------------------------------------+
void WriteEpisodesHeader(const int h)
{
   if(h==INVALID_HANDLE) return;
   // State codes: 0=no decision, 1=rejection, 2=sweep rejection,
   // 3=breakout without acceptance, 4=clean breakout, 5=failed acceptance.
   string line="episode_id;level_id;episode_start_time_unix;decision_1bar_time_unix;decision_3bar_time_unix;episode_end_time_unix;eligible_time_unix;state_code;termination_code;right_censored;"
               "micro_touch_number;structural_touch_number;micro_index_within_structural;is_new_structural_touch;"
               "level_age_hours;bars_since_previous_micro;bars_since_previous_structural;"
               "max_departure_previous_structural_atr;structural_reset_swing_confirmed;"
               "previous_micro_reaction_mfe_atr;previous_micro_reaction_mae_atr;"
               "previous_structural_reaction_atr;previous2_structural_reaction_atr;"
               "previous_structural_penetration_atr;previous2_structural_penetration_atr;"
               "atr_touch;zone_half_width_price;episode_bars;bars_in_zone;zone_crossings;"
               "max_penetration_atr;max_rejection_excursion_atr;max_breakout_excursion_atr;"
               "sweep_seen;acceptance_seen;acceptance_confirm_time_unix;failed_acceptance_seen;failure_confirm_time_unix;"
               "close_beyond_count;max_consecutive_closes_beyond;"
               "approach_bars;approach_distance_atr;attack_path_atr;attack_net_progress_atr;"
               "attack_aligned_body_atr;attack_total_body_atr;attack_close_location;"
               "approach_tick_volume_mean;prior_tick_volume_mean;approach_range_mean_atr;prior_range_mean_atr;"
               "defender_bars;defender_reaction_distance_atr;defender_path_atr;"
               "defender_aligned_body_atr;defender_total_body_atr;defender_close_location;"
               "near_level_close_count;breakout_side_close_count;rejection_side_close_count;episode_close_count;"
               "touch_open_rel_atr;touch_high_rel_atr;touch_low_rel_atr;touch_close_rel_atr;touch_spread_points;"
               "eligible_open_rel_atr;eligible_high_rel_atr;eligible_low_rel_atr;eligible_close_rel_atr;"
               "rejection_mfe_5_atr;rejection_mae_5_atr;rejection_mfe_10_atr;rejection_mae_10_atr;"
               "rejection_mfe_20_atr;rejection_mae_20_atr;rejection_mfe_48_atr;rejection_mae_48_atr;"
               "breakout_mfe_5_atr;breakout_mae_5_atr;breakout_mfe_10_atr;breakout_mae_10_atr;"
               "breakout_mfe_20_atr;breakout_mae_20_atr;breakout_mfe_48_atr;breakout_mae_48_atr;"
               "close_change_5_atr;close_change_10_atr;close_change_20_atr;close_change_48_atr";
   FileWriteString(h,line+"\r\n");
}

//+------------------------------------------------------------------+
void WriteEventsHeader(const int h)
{
   if(h==INVALID_HANDLE) return;
   string line="event_id;episode_id;level_id;event_time_unix;bar_offset;event_code;"
               "event_value_atr;close_rel_atr;penetration_atr;beyond_run;in_zone";
   FileWriteString(h,line+"\r\n");
}

//+------------------------------------------------------------------+
void WriteEvent(const int h,const long episode_id,const long level_id,const MqlRates &base[],
                const int touch_i,const int event_i,const string event_code,
                const double event_value_atr,const double close_rel_atr,
                const double penetration_atr,const int beyond_run,const bool in_zone)
{
   if(h==INVALID_HANDLE) return;
   if(h==INVALID_HANDLE || event_i<0 || event_i>=ArraySize(base)) return;
   string row="";
   CsvAddInt(row,++g_next_event_id);
   CsvAddInt(row,episode_id);
   CsvAddInt(row,level_id);
   CsvAddInt(row,(long)base[event_i].time);
   CsvAddInt(row,event_i-touch_i);
   CsvAddText(row,event_code);
   CsvAddDouble(row,event_value_atr);
   CsvAddDouble(row,close_rel_atr);
   CsvAddDouble(row,penetration_atr);
   CsvAddInt(row,beyond_run);
   CsvAddInt(row,(int)in_zone);
   FileWriteString(h,row+"\r\n");
}

//+------------------------------------------------------------------+
void HorizonExcursion(const MqlRates &base[],const int entry_i,const int horizon,const double atr,
                      const LevelData &level,double &rej_mfe,double &rej_mae,double &brk_mfe,double &brk_mae)
{
   rej_mfe=0.0; rej_mae=0.0; brk_mfe=0.0; brk_mae=0.0;
   if(entry_i<0 || entry_i>=ArraySize(base) || atr<=0.0) return;
   int end=MathMin(ArraySize(base)-1,entry_i+horizon);
   double ref=base[entry_i].close;
   double rejection_sign=(level.side==SIDE_RESISTANCE ? -1.0 : 1.0);
   double breakout_sign=-rejection_sign;
   for(int k=entry_i+1;k<=end;k++)
   {
      double hi=(base[k].high-ref)/atr;
      double lo=(base[k].low-ref)/atr;
      if(rejection_sign>0){rej_mfe=MathMax(rej_mfe,hi);rej_mae=MathMax(rej_mae,-lo);}
      else                {rej_mfe=MathMax(rej_mfe,-lo);rej_mae=MathMax(rej_mae,hi);}
      if(breakout_sign>0) {brk_mfe=MathMax(brk_mfe,hi);brk_mae=MathMax(brk_mae,-lo);}
      else                {brk_mfe=MathMax(brk_mfe,-lo);brk_mae=MathMax(brk_mae,hi);}
   }
}

//+------------------------------------------------------------------+
bool ExportEpisode(const int h,const int h_events,const long episode_id,LevelData &level,const MqlRates &base[],
                   const int touch_i,const int level_end_i,int &episode_end_i)
{
   double atr_touch=ATR(base,touch_i,InpATRPeriod);
   if(atr_touch<=0.0) return false;
   double zone=MathMax(InpTouchZoneATR*atr_touch,InpMinTouchZonePips*g_pip);
   double leave=MathMax(InpLeaveZoneATR*atr_touch,zone*2.0);
   if(g_hook_enabled)
   {
      int bn=ArraySize(base);
      datetime d3t=0;
      if(touch_i+3<bn) d3t=base[touch_i+3].time;                    // D3-бар закритий/присутній
      else if(touch_i+3==bn && g_target_d3>0) d3t=g_target_d3;      // D3 = поточний формуючий бар (live-край)
      if(d3t>0) C2_Collect(level,base,touch_i,atr_touch,zone,d3t);
   }

   int tail_req=(g_hook_enabled ? InpEdgeStateTail : InpOutcomeBars); // live: state потребує лише r20; export: канонічні 48
   int max_end=MathMin(level_end_i,MathMin(ArraySize(base)-1-tail_req,touch_i+InpMaxEpisodeBars));
   if(max_end<=touch_i) return false;

   bool sweep_seen=false;
   bool acceptance_seen=false;
   bool failure_seen=false;
   int acceptance_i=-1;
   int failure_i=-1;
   int first_penetration_i=-1;
   int first_close_beyond_i=-1;
   int beyond_run=0;
   int max_beyond_run=0;
   int failure_run=0;
   int close_beyond_count=0;
   int leave_rej_run=0;
   int leave_brk_run=0;
   int bars_in_zone=0;
   int crossings=0;
   int previous_relation=0;
   double max_penetration=0.0;
   double max_rejection_excursion=0.0;
   double max_breakout_excursion=0.0;
   episode_end_i=max_end;
   string state="NO_DECISION";
   string termination_code="MAX_EPISODE_BARS";
   bool right_censored=true;

   for(int i=touch_i;i<=max_end;i++)
   {
      bool in_zone=(base[i].low<=level.price+zone && base[i].high>=level.price-zone);
      if(in_zone) bars_in_zone++;

      int relation=(base[i].close>level.price+zone ? 1 : (base[i].close<level.price-zone ? -1 : 0));
      if(previous_relation!=0 && relation!=0 && relation!=previous_relation) crossings++;
      if(relation!=0) previous_relation=relation;

      double penetration=(level.side==SIDE_RESISTANCE ? base[i].high-level.price : level.price-base[i].low);
      penetration=MathMax(0.0,penetration)/atr_touch;
      max_penetration=MathMax(max_penetration,penetration);

      bool beyond=IsBeyond(base[i].close,level);
      if(beyond)
      {
         close_beyond_count++;
         beyond_run++;
         max_beyond_run=MathMax(max_beyond_run,beyond_run);
      }
      else beyond_run=0;

      bool meaningful_penetration=(penetration>=InpMeaningfulPenetrationATR);
      if(meaningful_penetration && first_penetration_i<0) first_penetration_i=i;
      if(beyond && first_close_beyond_i<0) first_close_beyond_i=i;
      if(meaningful_penetration && !beyond) sweep_seen=true;

      if(!acceptance_seen && beyond_run>=InpAcceptanceBars)
      {
         acceptance_seen=true;
         acceptance_i=i;
      }

      if(acceptance_seen && !failure_seen)
      {
         bool returned=(level.side==SIDE_RESISTANCE ? base[i].close<level.price : base[i].close>level.price);
         if(returned) failure_run++; else failure_run=0;
         if(failure_run>=InpFailureConfirmBars)
         {
            failure_seen=true;
            failure_i=i;
         }
      }

      double rej_exc=SignedMoveFromLevel(base[i].close,level)/atr_touch;
      double brk_exc=-rej_exc;
      max_rejection_excursion=MathMax(max_rejection_excursion,rej_exc);
      max_breakout_excursion=MathMax(max_breakout_excursion,brk_exc);

      double distance_close=MathAbs(base[i].close-level.price);
      bool far_enough=(distance_close>=leave);
      if(far_enough && IsRejectionSide(base[i].close,zone,level)) leave_rej_run++; else leave_rej_run=0;
      if(far_enough && IsBreakoutSide(base[i].close,zone,level))  leave_brk_run++; else leave_brk_run=0;

      if(i>touch_i && leave_rej_run>=InpLeaveConfirmBars)
      {
         episode_end_i=i;
         if(failure_seen) state="FAILED_ACCEPTANCE";
         else if(sweep_seen) state="SWEEP_REJECTION";
         else state="REJECTION";
         termination_code="LEAVE_REJECTION";
         right_censored=false;
         break;
      }
      if(i>touch_i && leave_brk_run>=InpLeaveConfirmBars)
      {
         episode_end_i=i;
         if(acceptance_seen && !failure_seen) state="CLEAN_BREAKOUT";
         else state="BREAKOUT_NO_ACCEPTANCE";
         termination_code="LEAVE_BREAKOUT";
         right_censored=false;
         break;
      }
   }

   if(right_censored)
   {
      if(max_end>=level_end_i) termination_code="LEVEL_END_CENSORED";
      else if(max_end>=ArraySize(base)-1-InpOutcomeBars) termination_code="DATA_END_CENSORED";
      else termination_code="MAX_EPISODE_BARS";
   }

   int entry_i=episode_end_i;
   if(state=="FAILED_ACCEPTANCE" && failure_i>=0) entry_i=failure_i;
   else if(state=="CLEAN_BREAKOUT" && acceptance_i>=0) entry_i=acceptance_i;
   if(entry_i+InpOutcomeBars>=ArraySize(base)) return false;

   int approach_from=MathMax(0,touch_i-InpApproachBars);
   int approach_bars=touch_i-approach_from;
   int expected_dir=(level.side==SIDE_RESISTANCE ? 1 : -1);
   double approach_distance=MathAbs(base[approach_from].close-level.price);
   double approach_speed=(approach_bars>0 ? SafeDiv(approach_distance,atr_touch*approach_bars,0.0) : 0.0);
   double approach_eff=DirectionalEfficiency(base,approach_from,touch_i);
   double aligned=(approach_bars>0 ? (double)CountAlignedBars(base,approach_from+1,touch_i,expected_dir)/approach_bars : 0.0);

   int prior_from=MathMax(0,approach_from-InpApproachBars);
   double approach_vol=MeanTickVolume(base,approach_from,touch_i);
   double prior_vol=MeanTickVolume(base,prior_from,MathMax(prior_from,approach_from-1));
   double volume_ratio=SafeDiv(approach_vol,prior_vol,1.0);
   double approach_range=MeanRange(base,approach_from,touch_i);
   double prior_range=MeanRange(base,prior_from,MathMax(prior_from,approach_from-1));
   double range_ratio=SafeDiv(approach_range,prior_range,1.0);

   int fast_from=MathMax(0,touch_i-InpCompressionFastBars+1);
   int slow_from=MathMax(0,touch_i-InpCompressionSlowBars+1);
   double fast_range=MeanRange(base,fast_from,touch_i);
   double slow_range=MeanRange(base,slow_from,MathMax(slow_from,touch_i-InpCompressionFastBars));
   double compression_ratio=SafeDiv(fast_range,slow_range,1.0);

   int tf_from=MathMax(0,touch_i-InpTrendFastBars);
   int ts_from=MathMax(0,touch_i-InpTrendSlowBars);
   double trend_fast=(base[touch_i].close-base[tf_from].close)/atr_touch;
   double trend_slow=(base[touch_i].close-base[ts_from].close)/atr_touch;
   int day_open_i=FindDayOpenIndex(base,touch_i);
   double day_open_distance=(base[touch_i].close-base[day_open_i].open)/atr_touch;

   double prev_mfe=level.last_reaction_mfe_atr;
   double prev_mae=level.last_reaction_mae_atr;
   double micro_ratio=EMPTY_VALUE;
   if(prev_mfe!=EMPTY_VALUE && prev_mfe>=InpReactionValidFloorATR)
      micro_ratio=SafeDiv(max_rejection_excursion,prev_mfe,EMPTY_VALUE);

   int micro_touch_number=level.episodes+1;
   int bars_since_prev_micro=(level.last_episode_end_index<-999000 ? -1 : touch_i-level.last_episode_end_index);
   int bars_since_prev_structural=(level.last_structural_touch_index<-999000 ? -1 : touch_i-level.last_structural_touch_index);
   double max_departure_structural=0.0;
   bool reset_swing=false;
   bool is_new_structural=(level.structural_touches==0);
   if(!is_new_structural)
      is_new_structural=StructuralResetConfirmed(base,level.last_structural_end_index,touch_i,level,atr_touch,
                                                max_departure_structural,reset_swing);

   int structural_touch_number=(is_new_structural ? level.structural_touches+1 : level.structural_touches);
   int micro_within_structural=(is_new_structural ? 1 : level.micro_in_current_structural+1);

   double prev_struct_reaction=level.last_structural_reaction_atr;
   double prev2_struct_reaction=level.prev2_structural_reaction_atr;
   double struct_ratio=EMPTY_VALUE;
   double struct_change=EMPTY_VALUE;
   if(prev_struct_reaction!=EMPTY_VALUE)
   {
      struct_change=max_rejection_excursion-prev_struct_reaction;
      if(prev_struct_reaction>=InpReactionValidFloorATR)
         struct_ratio=SafeDiv(max_rejection_excursion,prev_struct_reaction,EMPTY_VALUE);
   }
   double reaction_slope_prior=HistorySlope(level.structural_touches,level.structural_sum_x,level.structural_sum_x2,
                                           level.reaction_sum_y,level.reaction_sum_xy);
   double prev_struct_pen=level.last_structural_penetration_atr;
   double prev2_struct_pen=level.prev2_structural_penetration_atr;
   double penetration_change=EMPTY_VALUE;
   if(prev_struct_pen!=EMPTY_VALUE) penetration_change=max_penetration-prev_struct_pen;
   double penetration_slope_prior=HistorySlope(level.structural_touches,level.structural_sum_x,level.structural_sum_x2,
                                              level.penetration_sum_y,level.penetration_sum_xy);

   // Battle-round features. Attacker direction is toward a breakout of the level.
   int attacker_direction=(level.side==SIDE_RESISTANCE ? 1 : -1);
   int defender_direction=-attacker_direction;
   double attack_path_atr=SafeDiv(PathDistance(base,approach_from,touch_i),atr_touch,0.0);
   double attack_net_progress_atr=SafeDiv(SignedDirectionMove(base[approach_from].close,base[touch_i].close,attacker_direction),atr_touch,0.0);
   double attack_efficiency_signed=SafeDiv(attack_net_progress_atr,attack_path_atr,0.0);

   double attack_aligned_body=0.0,attack_total_body=0.0;
   for(int k=approach_from+1;k<=touch_i;k++)
   {
      double body=MathAbs(base[k].close-base[k].open);
      attack_total_body+=body;
      if(attacker_direction*(base[k].close-base[k].open)>0.0) attack_aligned_body+=body;
   }
   double attack_aligned_body_ratio=SafeDiv(attack_aligned_body,attack_total_body,0.0);
   double attack_close_location=(attacker_direction>0 ? CloseLocationValue(base[touch_i]) : 1.0-CloseLocationValue(base[touch_i]));
   double attack_effort_volume_atr=volume_ratio*attack_path_atr;
   double attack_effort_range_atr=range_ratio*attack_path_atr;
   double attack_result_penetration_atr=max_penetration;
   double attack_result_close_beyond_atr=MathMax(0.0,attacker_direction*(base[episode_end_i].close-level.price)/atr_touch);
   double attack_effort_per_result=SafeDiv(attack_path_atr,MathMax(attack_result_penetration_atr,0.01),EMPTY_VALUE);

   int defend_from=touch_i;
   int defend_to=episode_end_i;
   int defend_bars=MathMax(1,defend_to-defend_from);
   double defender_reaction_distance_atr=MathMax(0.0,defender_direction*(base[defend_to].close-level.price)/atr_touch);
   double defender_reaction_speed=SafeDiv(defender_reaction_distance_atr,(double)defend_bars,0.0);
   double defender_path_atr=SafeDiv(PathDistance(base,defend_from,defend_to),atr_touch,0.0);
   double defender_reaction_efficiency=SafeDiv(defender_reaction_distance_atr,defender_path_atr,0.0);
   double defender_aligned_body=0.0,defender_total_body=0.0;
   int near_count=0,breakout_close_count=0,rejection_close_count=0,total_episode_closes=0;
   for(int k=touch_i;k<=episode_end_i;k++)
   {
      double body=MathAbs(base[k].close-base[k].open);
      defender_total_body+=body;
      if(defender_direction*(base[k].close-base[k].open)>0.0) defender_aligned_body+=body;
      double signed_from_level=attacker_direction*(base[k].close-level.price)/atr_touch;
      if(MathAbs(signed_from_level)<=InpCloseNearLevelATR) near_count++;
      if(signed_from_level>InpTouchZoneATR) breakout_close_count++;
      if(signed_from_level<-InpTouchZoneATR) rejection_close_count++;
      total_episode_closes++;
   }
   double defender_aligned_body_ratio=SafeDiv(defender_aligned_body,defender_total_body,0.0);
   double defender_close_location=(defender_direction>0 ? CloseLocationValue(base[episode_end_i]) : 1.0-CloseLocationValue(base[episode_end_i]));
   double defender_result_vs_previous=EMPTY_VALUE;
   if(prev_struct_reaction!=EMPTY_VALUE) defender_result_vs_previous=defender_reaction_distance_atr-prev_struct_reaction;
   double attacker_progress_vs_previous=EMPTY_VALUE;
   if(prev_struct_pen!=EMPTY_VALUE) attacker_progress_vs_previous=attack_result_penetration_atr-prev_struct_pen;
   int retest_interval_bars=bars_since_prev_structural;
   double retest_interval_hours=(retest_interval_bars>=0 ? retest_interval_bars*PeriodSeconds(InpBaseTimeframe)/3600.0 : EMPTY_VALUE);
   double near_level_close_ratio=SafeDiv((double)near_count,(double)total_episode_closes,0.0);
   double breakout_side_close_ratio=SafeDiv((double)breakout_close_count,(double)total_episode_closes,0.0);
   double rejection_side_close_ratio=SafeDiv((double)rejection_close_count,(double)total_episode_closes,0.0);
   double net_battle_progress_atr=attack_result_penetration_atr-defender_reaction_distance_atr;

   double r5m,r5a,b5m,b5a,r10m,r10a,b10m,b10a,r20m,r20a,b20m,b20a,r48m,r48a,b48m,b48a;
   HorizonExcursion(base,entry_i,5,atr_touch,level,r5m,r5a,b5m,b5a);
   HorizonExcursion(base,entry_i,10,atr_touch,level,r10m,r10a,b10m,b10a);
   HorizonExcursion(base,entry_i,20,atr_touch,level,r20m,r20a,b20m,b20a);
   HorizonExcursion(base,entry_i,48,atr_touch,level,r48m,r48a,b48m,b48a);

   double c5=(base[entry_i+5].close-base[entry_i].close)/atr_touch;
   double c10=(base[entry_i+10].close-base[entry_i].close)/atr_touch;
   double c20=(base[entry_i+20].close-base[entry_i].close)/atr_touch;
   double c48=(base[entry_i+48].close-base[entry_i].close)/atr_touch;

   string row="";
   CsvAddInt(row,episode_id);
   CsvAddInt(row,level.id);
   CsvAddInt(row,(long)base[touch_i].time);
   if(touch_i+1<ArraySize(base)) CsvAddInt(row,(long)base[touch_i+1].time); else CsvAddText(row,"");
   if(touch_i+3<ArraySize(base)) CsvAddInt(row,(long)base[touch_i+3].time); else CsvAddText(row,"");
   CsvAddInt(row,(long)base[episode_end_i].time);
   CsvAddInt(row,(long)base[entry_i].time);
   CsvAddInt(row,StateCode(state));
   CsvAddText(row,termination_code);
   CsvAddInt(row,(int)right_censored);
   CsvAddInt(row,micro_touch_number);
   CsvAddInt(row,structural_touch_number);
   CsvAddInt(row,micro_within_structural);
   CsvAddInt(row,(int)is_new_structural);
   CsvAddDouble(row,SafeDiv((double)(base[touch_i].time-level.available_time),3600.0,0.0),2);
   CsvAddInt(row,bars_since_prev_micro);
   CsvAddInt(row,bars_since_prev_structural);
   CsvAddDouble(row,max_departure_structural);
   CsvAddInt(row,(int)reset_swing);
   CsvAddDouble(row,prev_mfe);
   CsvAddDouble(row,prev_mae);
   CsvAddDouble(row,prev_struct_reaction);
   CsvAddDouble(row,prev2_struct_reaction);
   CsvAddDouble(row,prev_struct_pen);
   CsvAddDouble(row,prev2_struct_pen);
   CsvAddDouble(row,atr_touch,g_digits+1);
   CsvAddDouble(row,zone,g_digits+1);
   CsvAddInt(row,episode_end_i-touch_i+1);
   CsvAddInt(row,bars_in_zone);
   CsvAddInt(row,crossings);
   CsvAddDouble(row,max_penetration);
   CsvAddDouble(row,max_rejection_excursion);
   CsvAddDouble(row,max_breakout_excursion);
   CsvAddInt(row,(int)sweep_seen);
   CsvAddInt(row,(int)acceptance_seen);
   if(acceptance_i>=0) CsvAddInt(row,(long)base[acceptance_i].time); else CsvAddText(row,"");
   CsvAddInt(row,(int)failure_seen);
   if(failure_i>=0) CsvAddInt(row,(long)base[failure_i].time); else CsvAddText(row,"");
   CsvAddInt(row,close_beyond_count);
   CsvAddInt(row,max_beyond_run);
   CsvAddInt(row,approach_bars);
   CsvAddDouble(row,SafeDiv(approach_distance,atr_touch,0.0));
   CsvAddDouble(row,attack_path_atr);
   CsvAddDouble(row,attack_net_progress_atr);
   CsvAddDouble(row,SafeDiv(attack_aligned_body,atr_touch,0.0));
   CsvAddDouble(row,SafeDiv(attack_total_body,atr_touch,0.0));
   CsvAddDouble(row,attack_close_location);
   CsvAddDouble(row,approach_vol,1);
   CsvAddDouble(row,prior_vol,1);
   CsvAddDouble(row,SafeDiv(approach_range,atr_touch,0.0));
   CsvAddDouble(row,SafeDiv(prior_range,atr_touch,0.0));
   CsvAddInt(row,defend_bars);
   CsvAddDouble(row,defender_reaction_distance_atr);
   CsvAddDouble(row,defender_path_atr);
   CsvAddDouble(row,SafeDiv(defender_aligned_body,atr_touch,0.0));
   CsvAddDouble(row,SafeDiv(defender_total_body,atr_touch,0.0));
   CsvAddDouble(row,defender_close_location);
   CsvAddInt(row,near_count);
   CsvAddInt(row,breakout_close_count);
   CsvAddInt(row,rejection_close_count);
   CsvAddInt(row,total_episode_closes);
   CsvAddDouble(row,(base[touch_i].open-level.price)/atr_touch);
   CsvAddDouble(row,(base[touch_i].high-level.price)/atr_touch);
   CsvAddDouble(row,(base[touch_i].low-level.price)/atr_touch);
   CsvAddDouble(row,(base[touch_i].close-level.price)/atr_touch);
   CsvAddInt(row,base[touch_i].spread);
   CsvAddDouble(row,(base[entry_i].open-level.price)/atr_touch);
   CsvAddDouble(row,(base[entry_i].high-level.price)/atr_touch);
   CsvAddDouble(row,(base[entry_i].low-level.price)/atr_touch);
   CsvAddDouble(row,(base[entry_i].close-level.price)/atr_touch);
   CsvAddDouble(row,r5m); CsvAddDouble(row,r5a); CsvAddDouble(row,r10m); CsvAddDouble(row,r10a);
   CsvAddDouble(row,r20m); CsvAddDouble(row,r20a); CsvAddDouble(row,r48m); CsvAddDouble(row,r48a);
   CsvAddDouble(row,b5m); CsvAddDouble(row,b5a); CsvAddDouble(row,b10m); CsvAddDouble(row,b10a);
   CsvAddDouble(row,b20m); CsvAddDouble(row,b20a); CsvAddDouble(row,b48m); CsvAddDouble(row,b48a);
   CsvAddDouble(row,c5); CsvAddDouble(row,c10); CsvAddDouble(row,c20); CsvAddDouble(row,c48);
   if(h!=INVALID_HANDLE) FileWriteString(h,row+"\r\n");

   // Sparse event stream: only state changes, never every bar.
   double touch_pen=MathMax(0.0,(level.side==SIDE_RESISTANCE ? base[touch_i].high-level.price : level.price-base[touch_i].low))/atr_touch;
   bool touch_zone=(base[touch_i].low<=level.price+zone && base[touch_i].high>=level.price-zone);
   WriteEvent(h_events,episode_id,level.id,base,touch_i,touch_i,"TOUCH_START",0.0,
              (base[touch_i].close-level.price)/atr_touch,touch_pen,0,touch_zone);
   if(first_penetration_i>=0)
   {
      double p=MathMax(0.0,(level.side==SIDE_RESISTANCE ? base[first_penetration_i].high-level.price : level.price-base[first_penetration_i].low))/atr_touch;
      bool z=(base[first_penetration_i].low<=level.price+zone && base[first_penetration_i].high>=level.price-zone);
      WriteEvent(h_events,episode_id,level.id,base,touch_i,first_penetration_i,"MEANINGFUL_PENETRATION",p,
                 (base[first_penetration_i].close-level.price)/atr_touch,p,0,z);
   }
   if(first_close_beyond_i>=0)
   {
      double p=MathMax(0.0,(level.side==SIDE_RESISTANCE ? base[first_close_beyond_i].high-level.price : level.price-base[first_close_beyond_i].low))/atr_touch;
      bool z=(base[first_close_beyond_i].low<=level.price+zone && base[first_close_beyond_i].high>=level.price-zone);
      WriteEvent(h_events,episode_id,level.id,base,touch_i,first_close_beyond_i,"FIRST_CLOSE_BEYOND",0.0,
                 (base[first_close_beyond_i].close-level.price)/atr_touch,p,1,z);
   }
   if(acceptance_i>=0)
      WriteEvent(h_events,episode_id,level.id,base,touch_i,acceptance_i,"ACCEPTANCE_CONFIRMED",0.0,
                 (base[acceptance_i].close-level.price)/atr_touch,max_penetration,InpAcceptanceBars,false);
   if(failure_i>=0)
      WriteEvent(h_events,episode_id,level.id,base,touch_i,failure_i,"FAILURE_CONFIRMED",0.0,
                 (base[failure_i].close-level.price)/atr_touch,max_penetration,0,false);
   WriteEvent(h_events,episode_id,level.id,base,touch_i,episode_end_i,termination_code,0.0,
              (base[episode_end_i].close-level.price)/atr_touch,max_penetration,max_beyond_run,false);

   level.episodes++;
   if(sweep_seen) level.sweeps++;
   if(state=="REJECTION" || state=="SWEEP_REJECTION") level.rejections++;
   if(acceptance_seen) level.acceptances++;
   if(state=="FAILED_ACCEPTANCE") level.failed_acceptances++;
   if(state=="CLEAN_BREAKOUT") level.clean_breakouts++;
   level.last_reaction_mfe_atr=r20m;
   level.last_reaction_mae_atr=r20a;
   level.last_episode_end_index=episode_end_i;

   if(is_new_structural)
   {
      level.structural_touches++;
      level.micro_in_current_structural=1;
      level.last_structural_touch_index=touch_i;
      level.last_structural_end_index=episode_end_i;

      double x=(double)level.structural_touches;
      level.structural_sum_x+=x;
      level.structural_sum_x2+=x*x;
      level.reaction_sum_y+=r20m;
      level.reaction_sum_xy+=x*r20m;
      level.penetration_sum_y+=max_penetration;
      level.penetration_sum_xy+=x*max_penetration;

      level.prev2_structural_reaction_atr=level.last_structural_reaction_atr;
      level.last_structural_reaction_atr=r20m;
      level.prev2_structural_penetration_atr=level.last_structural_penetration_atr;
      level.last_structural_penetration_atr=max_penetration;
   }
   else
   {
      level.micro_in_current_structural++;
      level.last_structural_end_index=episode_end_i;
   }
   return true;
}

//+------------------------------------------------------------------+
int RunEnginePass(void)
{
   g_symbol=(InpSymbol=="" ? _Symbol : InpSymbol);
   if(!SymbolSelect(g_symbol,true))
   {
      PrintFormat("LEVEL_BATTLE_ERROR | SymbolSelect failed | symbol=%s err=%d",g_symbol,GetLastError());
      return 1;
   }

   g_point=SymbolInfoDouble(g_symbol,SYMBOL_POINT);
   g_digits=(int)SymbolInfoInteger(g_symbol,SYMBOL_DIGITS);
   g_pip=((g_digits==3 || g_digits==5) ? g_point*10.0 : g_point);
   if(g_point<=0.0 || g_pip<=0.0 || g_run_from>=g_run_to)
   {
      Print("LEVEL_BATTLE_ERROR | Invalid symbol properties or time range");
      return 2;
   }

   LevelData levels[];
   if(InpUsePreviousDayLevels)
      BuildCalendarLevels(levels,PERIOD_D1,"PDH","PDL",InpMaxCalendarLevelAgeDays);
   if(InpUsePreviousWeekLevels)
      BuildCalendarLevels(levels,PERIOD_W1,"PWH","PWL",InpMaxCalendarLevelAgeDays);
   if(InpUsePreviousMonthLevels)
      BuildCalendarLevels(levels,PERIOD_MN1,"PMH","PML",InpMaxCalendarLevelAgeDays);
   if(InpUseH1Swings)
      BuildSwingLevels(levels,PERIOD_H1,"H1_SWING_HIGH","H1_SWING_LOW");
   if(InpUseH4Swings)
      BuildSwingLevels(levels,PERIOD_H4,"H4_SWING_HIGH","H4_SWING_LOW");

   int level_count=ArraySize(levels);
   if(level_count==0)
   {
      Print("LEVEL_BATTLE_ERROR | No levels generated");
      return 3;
   }

   MqlRates base[];
   int warmup_bars=MathMax(InpTrendSlowBars,MathMax(InpCompressionSlowBars,InpApproachBars))+InpATRPeriod+20;
   datetime warmup=g_run_from-(datetime)(warmup_bars*PeriodSeconds(InpBaseTimeframe));
   datetime extended_end=g_run_to+(datetime)((InpOutcomeBars+InpMaxEpisodeBars+5)*PeriodSeconds(InpBaseTimeframe));
   int base_n=CopyHistory(InpBaseTimeframe,warmup,extended_end,base);
   if(base_n<=warmup_bars+InpOutcomeBars)
   {
      PrintFormat("LEVEL_BATTLE_ERROR | Not enough base rates | copied=%d",base_n);
      return 4;
   }

   int h_levels=INVALID_HANDLE,h_episodes=INVALID_HANDLE,h_events=INVALID_HANDLE;
   if(g_files_enabled){
   string suffix=g_symbol+"_"+TfText(InpBaseTimeframe)+".csv";
   string levels_name=InpOutputPrefix+"_LevelBattleLevels_v003_EVENT_STREAM_"+suffix;
   string episodes_name=InpOutputPrefix+"_LevelBattleRounds_v003_EVENT_STREAM_"+suffix;
   string events_name=InpOutputPrefix+"_LevelBattleEvents_v003_EVENT_STREAM_"+suffix;
   int flags=FILE_WRITE|FILE_CSV|FILE_ANSI;
   if(InpUseCommonFolder) flags|=FILE_COMMON;
   h_levels=FileOpen(levels_name,flags,';');
   h_episodes=FileOpen(episodes_name,flags,';');
   h_events=FileOpen(events_name,flags,';');
   if(h_levels==INVALID_HANDLE || h_episodes==INVALID_HANDLE || h_events==INVALID_HANDLE)
   {
      PrintFormat("LEVEL_BATTLE_ERROR | FileOpen failed | err=%d",GetLastError());
      if(h_levels!=INVALID_HANDLE) FileClose(h_levels);
      if(h_episodes!=INVALID_HANDLE) FileClose(h_episodes);
      if(h_events!=INVALID_HANDLE) FileClose(h_events);
      return 5;
   }
   WriteLevelsHeader(h_levels);
   WriteEpisodesHeader(h_episodes);
   WriteEventsHeader(h_events);
   } // g_files_enabled

   long episode_id=0;
   for(int l=0;l<level_count;l++)
   {
      int start=FindFirstBaseIndexAtOrAfter(base,levels[l].available_time);
      datetime level_end_time=(levels[l].expiry_time<g_run_to ? levels[l].expiry_time : g_run_to);
      int level_end_i=FindFirstBaseIndexAtOrAfter(base,level_end_time)-1;
      // Канонічний clamp (export-режим): не сканувати хвіст без outcome-вікна.
      // У hook-режимі (live/parity) сканувати ДО краю: ExportEpisode сам поверне
      // false по внутрішньому guard (state канонічний), а хук побачить свіжі touch.
      if(!g_hook_enabled) level_end_i=MathMin(level_end_i,base_n-1-InpOutcomeBars);
      else                level_end_i=MathMin(level_end_i,base_n-1);
      if(start>=base_n || level_end_i<=start) continue;

      int i=MathMax(start,warmup_bars);
      while(i<=level_end_i)
      {
         if(InpMaxEpisodesPerLevel>0 && levels[l].episodes>=InpMaxEpisodesPerLevel) break;
         if(i-levels[l].last_episode_end_index<InpMinBarsBetweenEpisodes){i++;continue;}

         double atr=ATR(base,i,InpATRPeriod);
         if(atr<=0.0){i++;continue;}
         double zone=MathMax(InpTouchZoneATR*atr,InpMinTouchZonePips*g_pip);
         bool touched=(base[i].low<=levels[l].price+zone && base[i].high>=levels[l].price-zone);
         if(!touched){i++;continue;}

         int episode_end_i=i;
         long candidate_episode_id=episode_id+1;
         if(ExportEpisode(h_episodes,h_events,candidate_episode_id,levels[l],base,i,level_end_i,episode_end_i))
         {
            episode_id=candidate_episode_id;
            i=MathMax(i+1,episode_end_i+InpMinBarsBetweenEpisodes);
            if(InpFlushFrequently && (episode_id%500)==0){FileFlush(h_episodes);FileFlush(h_events);}
         }
         else i++;
      }
   }

   for(int l=0;l<level_count;l++)
   {
      string level_row="";
      CsvAddInt(level_row,levels[l].id);
      CsvAddText(level_row,levels[l].type);
      CsvAddText(level_row,TfText(levels[l].source_tf));
      CsvAddInt(level_row,levels[l].side);
      CsvAddPrice(level_row,levels[l].price);
      CsvAddInt(level_row,(long)levels[l].source_time);
      CsvAddInt(level_row,(long)levels[l].available_time);
      CsvAddInt(level_row,(long)levels[l].expiry_time);
      CsvAddInt(level_row,levels[l].source_index);
      CsvAddInt(level_row,levels[l].episodes);
      CsvAddInt(level_row,levels[l].structural_touches);
      CsvAddInt(level_row,levels[l].sweeps);
      CsvAddInt(level_row,levels[l].rejections);
      CsvAddInt(level_row,levels[l].acceptances);
      CsvAddInt(level_row,levels[l].failed_acceptances);
      CsvAddInt(level_row,levels[l].clean_breakouts);
      if(h_levels!=INVALID_HANDLE) FileWriteString(h_levels,level_row+"\r\n");
   }

   if(g_files_enabled) FileFlush(h_levels);
   if(g_files_enabled) FileFlush(h_episodes);
   if(g_files_enabled) FileFlush(h_events);
   if(g_files_enabled) FileClose(h_levels);
   if(g_files_enabled) FileClose(h_episodes);
   if(g_files_enabled) FileClose(h_events);

   if(g_files_enabled || g_parity_h!=INVALID_HANDLE)
      PrintFormat("LEVEL_BATTLE_EVENT_STREAM_DONE | symbol=%s base_tf=%s levels=%d episodes=%I64d",
               g_symbol,TfText(InpBaseTimeframe),level_count,episode_id);
   return 0;
}
//+------------------------------------------------------------------+

// ===== C2 features at touch (verbatim engine expressions, causal-only) =====
double EV0(const double v) { return (v==EMPTY_VALUE ? 0.0 : v); }

void C2_Collect(LevelData &level,const MqlRates &base[],const int touch_i,
                const double atr_touch,const double zone,const datetime d3t)
{
   int n=ArraySize(base);
   if(touch_i+2>=n) return; // потрібні лише закриті бари offset 0..2
   int approach_from=MathMax(0,touch_i-InpApproachBars);
   int approach_bars=touch_i-approach_from;
   double approach_distance=MathAbs(base[approach_from].close-level.price);
   double approach_vol=MeanTickVolume(base,approach_from,touch_i);
   int prior_from=MathMax(0,approach_from-InpApproachBars);
   double prior_vol=MeanTickVolume(base,prior_from,MathMax(prior_from,approach_from-1));
   double approach_range=MeanRange(base,approach_from,touch_i);
   double prior_range=MeanRange(base,prior_from,MathMax(prior_from,approach_from-1));
   double prev_mfe=level.last_reaction_mfe_atr;
   double prev_mae=level.last_reaction_mae_atr;
   int micro_touch_number=level.episodes+1;
   int bars_since_prev_micro=(level.last_episode_end_index<-999000 ? -1 : touch_i-level.last_episode_end_index);
   int bars_since_prev_structural=(level.last_structural_touch_index<-999000 ? -1 : touch_i-level.last_structural_touch_index);
   double max_departure_structural=0.0;
   bool reset_swing=false;
   bool is_new_structural=(level.structural_touches==0);
   if(!is_new_structural)
      is_new_structural=StructuralResetConfirmed(base,level.last_structural_end_index,touch_i,level,atr_touch,
                                                 max_departure_structural,reset_swing);
   int structural_touch_number=(is_new_structural ? level.structural_touches+1 : level.structural_touches);
   int micro_within_structural=(is_new_structural ? 1 : level.micro_in_current_structural+1);
   double prev_struct_reaction=level.last_structural_reaction_atr;
   double prev2_struct_reaction=level.prev2_structural_reaction_atr;
   double prev_struct_pen=level.last_structural_penetration_atr;
   double prev2_struct_pen=level.prev2_structural_penetration_atr;
   int attacker_direction=(level.side==SIDE_RESISTANCE ? 1 : -1);
   double attack_path_atr=SafeDiv(PathDistance(base,approach_from,touch_i),atr_touch,0.0);
   double attack_net_progress_atr=SafeDiv(SignedDirectionMove(base[approach_from].close,base[touch_i].close,attacker_direction),atr_touch,0.0);
   double attack_aligned_body=0.0,attack_total_body=0.0;
   for(int k=approach_from+1;k<=touch_i;k++)
   {
      double body=MathAbs(base[k].close-base[k].open);
      attack_total_body+=body;
      if(attacker_direction*(base[k].close-base[k].open)>0.0) attack_aligned_body+=body;
   }
   double attack_close_location=(attacker_direction>0 ? CloseLocationValue(base[touch_i]) : 1.0-CloseLocationValue(base[touch_i]));
   // t-features: bars offset 0..2, event replication
   double pen_row[6]; int off_row[6]; int code_row[6]; int nrow=0;
   double touch_pen=MathMax(0.0,(level.side==SIDE_RESISTANCE ? base[touch_i].high-level.price : level.price-base[touch_i].low))/atr_touch;
   pen_row[nrow]=touch_pen; off_row[nrow]=0; code_row[nrow]=0; nrow++;
   int mp_first=-1, fcb_first=-1, acc_off=-1, term_off=-1;
   int beyond_run=0, leave_rej_run=0, leave_brk_run=0;
   double leave2=MathMax(InpLeaveZoneATR*atr_touch,zone*2.0);
   double max_pen012=0.0;
   for(int k=0;k<=2;k++)
   {
      int i=touch_i+k;
      double penetration=(level.side==SIDE_RESISTANCE ? base[i].high-level.price : level.price-base[i].low);
      penetration=MathMax(0.0,penetration)/atr_touch;
      max_pen012=MathMax(max_pen012,penetration);
      bool beyond=IsBeyond(base[i].close,level);
      if(beyond) beyond_run++; else beyond_run=0;
      bool meaningful=(penetration>=InpMeaningfulPenetrationATR);
      if(meaningful && mp_first<0){ mp_first=k; pen_row[nrow]=penetration; off_row[nrow]=k; code_row[nrow]=1; nrow++; }
      if(beyond && fcb_first<0){ fcb_first=k; pen_row[nrow]=penetration; off_row[nrow]=k; code_row[nrow]=2; nrow++; }
      if(acc_off<0 && beyond_run>=InpAcceptanceBars){ acc_off=k; pen_row[nrow]=max_pen012; off_row[nrow]=k; code_row[nrow]=3; nrow++; }
      double distance_close=MathAbs(base[i].close-level.price);
      bool far_enough=(distance_close>=leave2);
      if(far_enough && IsRejectionSide(base[i].close,zone,level)) leave_rej_run++; else leave_rej_run=0;
      if(far_enough && IsBreakoutSide(base[i].close,zone,level))  leave_brk_run++; else leave_brk_run=0;
      if(term_off<0 && k>0 && (leave_rej_run>=InpLeaveConfirmBars || leave_brk_run>=InpLeaveConfirmBars))
      { term_off=k; pen_row[nrow]=max_pen012; off_row[nrow]=k; code_row[nrow]=4; nrow++; }
   }
   double t1=(mp_first>=0 ? (double)mp_first : -1.0);
   double t2=(fcb_first>=0 ? (double)fcb_first : -1.0);
   double t3=(mp_first>=0 ? 1.0 : 0.0);
   double t3b=t1;
   int arg=0; double pmax=-1.0;
   for(int r=0;r<nrow;r++) if(pen_row[r]>pmax){ pmax=pen_row[r]; arg=off_row[r]; }
   double t4=(pmax>0.0 ? pmax/(double)(arg+1) : 0.0);
   double t5=(double)nrow;
   int first_code=-1, first_off=99;
   for(int r=0;r<nrow;r++) if(code_row[r]!=0 && off_row[r]<first_off) { first_off=off_row[r]; first_code=code_row[r]; }
   double t6a=(first_code==1 ? 1.0 : 0.0);
   double t6b=(first_code==2 ? 1.0 : 0.0);
   double f[48]; double e=0.000001;
   f[0]=micro_touch_number; f[1]=structural_touch_number; f[2]=micro_within_structural;
   f[3]=(is_new_structural?1.0:0.0);
   f[4]=SafeDiv((double)(base[touch_i].time-level.available_time),3600.0,0.0);
   f[5]=bars_since_prev_micro; f[6]=bars_since_prev_structural;
   f[7]=max_departure_structural; f[8]=(reset_swing?1.0:0.0);
   f[9]=EV0(prev_mfe); f[10]=EV0(prev_mae);
   f[11]=EV0(prev_struct_reaction); f[12]=EV0(prev2_struct_reaction);
   f[13]=EV0(prev_struct_pen); f[14]=EV0(prev2_struct_pen);
   f[15]=approach_bars; f[16]=SafeDiv(approach_distance,atr_touch,0.0);
   f[17]=attack_path_atr; f[18]=attack_net_progress_atr;
   f[19]=SafeDiv(attack_aligned_body,atr_touch,0.0);
   f[20]=SafeDiv(attack_total_body,atr_touch,0.0);
   f[21]=attack_close_location;
   f[22]=approach_vol; f[23]=prior_vol;
   f[24]=SafeDiv(approach_range,atr_touch,0.0);
   f[25]=SafeDiv(prior_range,atr_touch,0.0);
   f[26]=(base[touch_i].open-level.price)/atr_touch;
   f[27]=(base[touch_i].high-level.price)/atr_touch;
   f[28]=(base[touch_i].low-level.price)/atr_touch;
   f[29]=(base[touch_i].close-level.price)/atr_touch;
   f[30]=(double)base[touch_i].spread;
   double netp=f[18], pathp=f[17];
   f[31]=netp/(pathp+e);
   f[32]=f[19]/(f[20]+e);
   f[33]=MathLog(1.0+f[22]/(f[23]+e));
   f[34]=MathLog(1.0+f[24]/(f[25]+e));
   f[35]=MathMax(-10.0,MathMin(10.0,EV0(prev_struct_reaction)-EV0(prev2_struct_reaction)));
   f[36]=MathMax(-10.0,MathMin(10.0,EV0(prev_struct_pen)-EV0(prev2_struct_pen)));
   f[37]=netp/(double)(approach_bars+1);
   f[38]=1.0-MathAbs(netp)/(pathp+e);
   f[39]=MathMax(0.0,MathMin(20.0,pathp-MathAbs(netp)));
   f[40]=t1; f[41]=t2; f[42]=t3; f[43]=t3b; f[44]=t4; f[45]=t5; f[46]=t6a; f[47]=t6b;
   double p=C2M_PWin(f,C2M_NWIN-1);
   int np=ArraySize(g_pcal);
   ArrayResize(g_pcal,np+1); ArrayResize(g_pcal_t,np+1);
   g_pcal[np]=p; g_pcal_t[np]=d3t;
   if(g_parity_h!=INVALID_HANDLE)
   {
      string row=IntegerToString((long)d3t)+";"+IntegerToString(level.id)+";"+
                 DoubleToString(level.price,g_digits)+";"+IntegerToString(level.side);
      for(int q=0;q<48;q++) row+=";"+DoubleToString(f[q],8);
      row+=";"+DoubleToString(p,8);
      FileWriteString(g_parity_h,row+"\r\n");
   }
   if(g_collect_all || (g_target_d3!=0 && d3t==g_target_d3))
   {
      int m=ArraySize(g_cands);
      ArrayResize(g_cands,m+1);
      g_cands[m].d3=d3t; g_cands[m].level_id=level.id; g_cands[m].price=level.price;
      g_cands[m].side=level.side;
      for(int q=0;q<48;q++) g_cands[m].f[q]=f[q];
      g_cands[m].p=p;
      g_cands[m].sd=1.5*MathMax(0.75,max_pen012)*atr_touch;
   }
}

// ===== runtime =====
bool LevelSignalAllowed(const long lid,const double lvl_price,const double leave_dist)
{
   for(int i=0;i<ArraySize(g_sl_level);i++)
   {
      if(g_sl_level[i]!=lid) continue;
      if(TimeCurrent()-g_sl_time[i] < (long)InpLevelCooldownBars*PeriodSeconds(PERIOD_M5)) return false;
      // ціна мусила ПОКИНУТИ зону рівня з часу минулого сигналу (канон: епізод завершився)
      int bars = iBarShift(_Symbol,PERIOD_M5,g_sl_time[i]);
      bool left=false;
      for(int b=1;b<=bars && b<600;b++)
      {
         double c=iClose(_Symbol,PERIOD_M5,b);
         if(c>0.0 && MathAbs(c-g_sl_price[i])>=g_sl_leave[i]){ left=true; break; }
      }
      if(!left) return false;
      // старий запис вичерпано — оновимо при новому сигналі
      return true;
   }
   return true;
}

void RememberLevelSignal(const long lid,const double lvl_price,const double leave_dist)
{
   for(int i=0;i<ArraySize(g_sl_level);i++)
      if(g_sl_level[i]==lid)
      {
         g_sl_time[i]=TimeCurrent(); g_sl_price[i]=lvl_price; g_sl_leave[i]=leave_dist;
         return;
      }
   int n=ArraySize(g_sl_level);
   ArrayResize(g_sl_level,n+1); ArrayResize(g_sl_time,n+1);
   ArrayResize(g_sl_price,n+1); ArrayResize(g_sl_leave,n+1);
   g_sl_level[n]=lid; g_sl_time[n]=TimeCurrent(); g_sl_price[n]=lvl_price; g_sl_leave[n]=leave_dist;
}

int MyOpenPositions()
{
   int c=0;
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong tk=PositionGetTicket(i);
      if(tk==0) continue;
      if(PositionGetInteger(POSITION_MAGIC)==InpMagic && PositionGetString(POSITION_SYMBOL)==_Symbol) c++;
   }
   return c;
}

double TrailingThreshold()
{
   datetime cutoff=TimeCurrent()-(datetime)(InpThrTrailDays*86400);
   int np=ArraySize(g_pcal);
   double tmp[]; ArrayResize(tmp,np); int m=0;
   for(int i=0;i<np;i++) if(g_pcal_t[i]>=cutoff){ tmp[m]=g_pcal[i]; m++; }
   if(m<200) return 1.1; // fail-closed until enough history
   ArrayResize(tmp,m); ArraySort(tmp);
   int idx=(int)MathFloor(InpThrQuantile*(m-1));
   return tmp[idx];
}

void RunPass(const datetime target)
{
   ArrayResize(g_cands,0);
   ArrayResize(g_pcal,0); ArrayResize(g_pcal_t,0);
   g_run_to=(target>0 ? target : TimeCurrent());
   g_run_from=g_run_to-(datetime)(InpWindowDays*86400);
   g_target_d3=target; // hook scores ALL d3 (p-history); candidates filtered inside
   g_hook_enabled=true; g_files_enabled=false;
   int rc=RunEnginePass();
   g_hook_enabled=false; g_target_d3=0;
   if(rc!=0) Log("ENGINE_FAIL","RunEnginePass rc="+IntegerToString(rc));
}

int OnInit()
{
   GV_PREFIX = StringFormat("FXA_CP_%lld_", InpMagic);
   trade.SetExpertMagicNumber(InpMagic);
   trade.SetDeviationInPoints(30);
   long tmode = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_MODE);
   if(tmode != SYMBOL_TRADE_MODE_FULL && !InpParityMode)
   {
      Log("INIT_FAIL", "trade mode="+IntegerToString((int)tmode));
      return INIT_FAILED;
   }
   g_initial_equity   = AccountInfoDouble(ACCOUNT_EQUITY);
   g_cur_day          = DayStart(TimeCurrent());
   g_day_start_equity = g_initial_equity;
   LoadState();
   if(InpFastSim)
   {
      g_run_from=InpParityFrom;
      g_run_to=(InpParityTo>0 ? InpParityTo : TimeCurrent());
      g_target_d3=0; g_collect_all=true; g_hook_enabled=true; g_files_enabled=false;
      int rc=RunEnginePass();
      g_hook_enabled=false; g_collect_all=false;
      int n=ArraySize(g_cands);
      Log("FASTSIM",StringFormat("pass rc=%d кандидатів=%d — сортування/симуляція",rc,n));
      // сортування за d3 (простий insertion по копіях індексів)
      int idx[]; ArrayResize(idx,n);
      for(int i=0;i<n;i++) idx[i]=i;
      for(int i=1;i<n;i++)
      {
         int key=idx[i]; int j=i-1;
         while(j>=0 && g_cands[idx[j]].d3>g_cands[key].d3){ idx[j+1]=idx[j]; j--; }
         idx[j+1]=key;
      }
      string fn="FXA_FastSim_Signals_"+_Symbol+".csv";
      int h=FileOpen(fn,FILE_WRITE|FILE_CSV|FILE_ANSI|FILE_COMMON,';');
      if(h==INVALID_HANDLE){ Log("INIT_FAIL","fastsim FileOpen"); return INIT_FAILED; }
      FileWriteString(h,"d3_unix;level_id;side;p;thr;sd;selected;reason\r\n");
      // причинний trailing-поріг: quantile 0.96 по p з [d3-90d; d3)
      double ph[]; datetime pt[];
      ArrayResize(ph,n); ArrayResize(pt,n);
      long lvl_ids[]; datetime lvl_t[];
      int day_cnt_day=0; long cur_day=-1; int nsel=0;
      for(int k=0;k<n;k++)
      {
         C2Cand c=g_cands[idx[k]];
         ph[k]=c.p; pt[k]=c.d3;
         // поріг
         datetime cut=c.d3-(datetime)(InpThrTrailDays*86400);
         double tmp[]; int m=0; ArrayResize(tmp,k);
         for(int q=0;q<k;q++) if(pt[q]>=cut){ tmp[m]=ph[q]; m++; }
         string reason=""; int selflag=0; double thr=1.1;
         if(m>=200)
         {
            ArrayResize(tmp,m); ArraySort(tmp);
            thr=tmp[(int)MathFloor(InpThrQuantile*(m-1))];
         }
         if(thr>1.0) reason="WARMUP";
         else if(c.p<thr) reason="BELOW_THR";
         else if(c.sd<InpMinStopPoints*_Point) reason="MICRO_SL";
         else
         {
            long day=(long)c.d3/86400;
            if(day!=cur_day){ cur_day=day; day_cnt_day=0; }
            // level-cooldown 4 бари
            bool dup=false;
            for(int q=0;q<ArraySize(lvl_ids);q++)
               if(lvl_ids[q]==c.level_id && c.d3-lvl_t[q]<(datetime)(InpLevelCooldownBars*300)){ dup=true; break; }
            if(dup) reason="LEVEL_DEDUP";
            else if(day_cnt_day>=InpMaxTradesPerDay) reason="DAY_CAP";
            else
            {
               selflag=1; reason="OPEN"; day_cnt_day++; nsel++;
               int L=ArraySize(lvl_ids);
               ArrayResize(lvl_ids,L+1); ArrayResize(lvl_t,L+1);
               lvl_ids[L]=c.level_id; lvl_t[L]=c.d3;
            }
         }
         FileWriteString(h,IntegerToString((long)c.d3)+";"+IntegerToString(c.level_id)+";"+
             IntegerToString(c.side)+";"+DoubleToString(c.p,6)+";"+DoubleToString(thr,6)+";"+
             DoubleToString(c.sd,5)+";"+IntegerToString(selflag)+";"+reason+"\r\n");
      }
      FileClose(h);
      Log("FASTSIM_DONE",StringFormat("кандидатів=%d selected=%d -> Common\\Files\\%s",n,nsel,fn));
      return INIT_SUCCEEDED;
   }
   if(InpAuditFrom>0 && InpAuditTo>InpAuditFrom)
   {
      string fn="FXA_EdgeAudit_"+_Symbol+".csv";
      int h=FileOpen(fn,FILE_WRITE|FILE_CSV|FILE_ANSI|FILE_COMMON,';');
      if(h==INVALID_HANDLE){ Log("INIT_FAIL","audit FileOpen"); return INIT_FAILED; }
      FileWriteString(h,"bar_unix;level_id;side;p;sd\r\n");
      datetime tarr[];
      int nb=CopyTime(_Symbol,PERIOD_M5,InpAuditFrom,InpAuditTo,tarr);
      Log("EDGEAUDIT",StringFormat("барів=%d — по-барні проходи (~%.0f хв)",nb,nb*0.9/60.0));
      for(int b=0;b<nb;b++)
      {
         RunPass(tarr[b]);
         for(int i=0;i<ArraySize(g_cands);i++)
            FileWriteString(h,IntegerToString((long)tarr[b])+";"+IntegerToString(g_cands[i].level_id)+";"+
                IntegerToString(g_cands[i].side)+";"+DoubleToString(g_cands[i].p,6)+";"+
                DoubleToString(g_cands[i].sd,5)+"\r\n");
         if((b%50)==0) Log("EDGEAUDIT",StringFormat("%d/%d",b,nb));
      }
      FileClose(h);
      Log("EDGEAUDIT_DONE","-> Common\\Files\\"+fn);
      return INIT_SUCCEEDED;
   }
   if(InpParityMode)
   {
      string pf="FXA_C2_FeatureParity_"+_Symbol+".csv";
      g_parity_h=FileOpen(pf,FILE_WRITE|FILE_CSV|FILE_ANSI|FILE_COMMON,';');
      if(g_parity_h==INVALID_HANDLE){ Log("INIT_FAIL","parity FileOpen err="+IntegerToString(GetLastError())); return INIT_FAILED; }
      FileWriteString(g_parity_h,"d3_unix;level_id;level_price;side;f0_47x48;p\r\n");
      g_run_from=InpParityFrom;
      g_run_to=(InpParityTo>0 ? InpParityTo : TimeCurrent());
      g_target_d3=0; g_hook_enabled=true; g_files_enabled=false;
      int rc=RunEnginePass();
      g_hook_enabled=false;
      FileFlush(g_parity_h); FileClose(g_parity_h); g_parity_h=INVALID_HANDLE;
      Log("PARITY_DONE","rc="+IntegerToString(rc)+" scored="+IntegerToString(ArraySize(g_pcal)));
      Log("INIT_OK","FXArena_ContPrimary v1.21 PARITY MODE (file in Common\\Files)");
      return INIT_SUCCEEDED;
   }
   if(!EventSetTimer(1)){ Log("INIT_FAIL","timer"); return INIT_FAILED; }
   Log("INIT_OK", StringFormat("FXArena_ContPrimary v1.21 | magic=%lld | risk=%.2f%% | C2 %d-win | thr=trail q%.2f/%dd",
       InpMagic, InpRiskPct, C2M_NWIN, InpThrQuantile, InpThrTrailDays));
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   EventKillTimer(); SaveState();
   Log("DEINIT","reason="+IntegerToString(reason));
}

void OnTimer()
{
   if(InpParityMode) return;
   RollDayIfNeeded();
   UpdateCooldownFromHistory();
   ManageTimeouts();
   if(!InpSignalsEnabled) return;

   datetime m5=iTime(_Symbol,PERIOD_M5,0);
   if(m5!=g_last_m5 && m5>0)
   {
      g_last_m5=m5;
      RunPass(m5);
      datetime d=DayStart(TimeCurrent());
      if(d!=g_thr_day)
      {
         double t=TrailingThreshold();
         if(t<=1.0)
           {
            g_thr=t; g_thr_day=d;
            Log("THR",StringFormat("trailing q%.2f = %.4f (n=%d)",InpThrQuantile,g_thr,ArraySize(g_pcal)));
            LogRemote(StringFormat("{\"type\":\"THR\",\"thr\":%.4f,\"phist\":%d,\"opens\":%d}",
                      g_thr, ArraySize(g_pcal), g_trades_today));
           }
         else Log("THR","insufficient p-history, trading blocked (fail-closed)");
      }
      g_pending_d3=(ArraySize(g_cands)>0 ? m5 : 0);
      if(InpDiagLog)
      {
         double bestp=0.0;
         for(int q=0;q<ArraySize(g_cands);q++) if(g_cands[q].p>bestp) bestp=g_cands[q].p;
         Log("DIAG",StringFormat("bar=%s cands=%d best_p=%.4f thr=%.4f phist=%d",
             TimeToString(m5,TIME_DATE|TIME_MINUTES),ArraySize(g_cands),bestp,g_thr,ArraySize(g_pcal)));
      }
   }
   if(g_pending_d3>0)
   {
      long since=(long)(TimeCurrent()-g_pending_d3);
      if(since>=60 && since<=InpEntryWindowSec)
      {
         for(int i=0;i<ArraySize(g_cands);i++)
         {
            if(g_cands[i].p < g_thr) continue;
            double leave_dist = g_cands[i].sd; // leave~1.2*ATR ~ sd-масштаб: ціна мусить відійти на SL-дистанцію
            if(!LevelSignalAllowed(g_cands[i].level_id, g_cands[i].price, leave_dist))
              { Log("SKIP",StringFormat("LEVEL_DEDUP lvl=%I64d",g_cands[i].level_id)); continue; }
            if(MyOpenPositions() >= InpMaxOpenPositions)
              { Log("SKIP","MAX_POS"); continue; }
            Log("SIGNAL",StringFormat("d3=%s lvl=%I64d p=%.4f thr=%.4f sd=%.5f",
                TimeToString(g_cands[i].d3,TIME_DATE|TIME_SECONDS), g_cands[i].level_id, g_cands[i].p, g_thr, g_cands[i].sd));
            g_last_sig_p=g_cands[i].p;
            if(OpenTrade(g_cands[i].side, g_cands[i].sd))
               RememberLevelSignal(g_cands[i].level_id, g_cands[i].price, leave_dist);
         }
         g_pending_d3=0;
      }
      else if(since>InpEntryWindowSec)
      {
         if(ArraySize(g_cands)>0) Log("SKIP","entry window missed");
         g_pending_d3=0;
      }
   }
}

void OnTick() { }
