import pandas as pd,numpy as np
W=pd.read_csv("out_oos/CORE_WAVES.csv"); t=W[W.taken==True].copy()
t["pos"]=pd.cut(t.entry_frac,[-9,1/3,2/3,9],labels=["1/3 перша","2/3 середина","3/3 остання"])
for sg,x in t.groupby("seg"):
    print("\n==",sg,len(x),"взятих рухів")
    print(x.pos.value_counts(normalize=True).sort_index().round(2).to_dict())
    print("за двигуном:"); print(pd.crosstab(x.eng_first,x.pos,normalize="index").round(2).to_string())
    print("за розміром:"); print(pd.crosstab(pd.cut(x['size'],[3,4.5,6,10,1e9],right=False),x.pos,normalize="index").round(2).to_string())
    print("R за рухом (сумарно) за позицією першого входу:",x.groupby("pos",observed=True).R_with.agg(["count","mean","sum"]).round(2).to_dict("index"))
